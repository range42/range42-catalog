RC_BASE_URL=http://{{ ansible_default_ipv4.address }}:{{ rocketchat_http_port }}
RC_ADMIN_USER={{ rocketchat_admin_user }}
RC_ADMIN_PASS={{ rocketchat_admin_pass }}
RC_ADMIN_EMAIL={{ rocketchat_admin_email }}
HTTP_PORT={{ rocketchat_http_port }}
OVERWRITE_SETTING_Site_Url=http://{{ ansible_default_ipv4.address }}:{{ rocketchat_http_port }}
NODE_EXTRA_CA_CERTS=/certs/gitea.crt
OVERWRITE_SETTING_Accounts_TwoFactorAuthentication_Enabled=false
OVERWRITE_SETTING_Accounts_TwoFactorAuthentication_By_Email_Enabled=false
OVERWRITE_SETTING_Accounts_OAuth_Custom-{{ rocketchat_oauth_name }}=true
OVERWRITE_SETTING_Accounts_OAuth_Custom-{{ rocketchat_oauth_name }}-url={{ rocketchat_gitea_base_url }}
OVERWRITE_SETTING_Accounts_OAuth_Custom-{{ rocketchat_oauth_name }}-id={{ rocketchat_gitea_client_id }}
OVERWRITE_SETTING_Accounts_OAuth_Custom-{{ rocketchat_oauth_name }}-secret={{ rocketchat_gitea_client_secret }}
OVERWRITE_SETTING_Accounts_OAuth_Custom-{{ rocketchat_oauth_name }}-token_path=/login/oauth/access_token
OVERWRITE_SETTING_Accounts_OAuth_Custom-{{ rocketchat_oauth_name }}-token_sent_via=header
OVERWRITE_SETTING_Accounts_OAuth_Custom-{{ rocketchat_oauth_name }}-identity_path=/api/v1/user
OVERWRITE_SETTING_Accounts_OAuth_Custom-{{ rocketchat_oauth_name }}-authorize_path=/login/oauth/authorize
OVERWRITE_SETTING_Accounts_OAuth_Custom-{{ rocketchat_oauth_name }}-scope=openid
OVERWRITE_SETTING_Accounts_OAuth_Custom-{{ rocketchat_oauth_name }}-login_style=redirect
OVERWRITE_SETTING_Accounts_OAuth_Custom-{{ rocketchat_oauth_name }}-username_field=login
OVERWRITE_SETTING_Accounts_OAuth_Custom-{{ rocketchat_oauth_name }}-name_field=full_name
OVERWRITE_SETTING_Accounts_OAuth_Custom-{{ rocketchat_oauth_name }}-email_field=email
OVERWRITE_SETTING_Accounts_OAuth_Custom-{{ rocketchat_oauth_name }}-merge_users=true
OVERWRITE_SETTING_Accounts_OAuth_Custom-{{ rocketchat_oauth_name }}-show_button=true
# No SMTP in Range42 lab — skip email verification for OAuth-created accounts
OVERWRITE_SETTING_Accounts_Verify_Email_For_External_Accounts=false
