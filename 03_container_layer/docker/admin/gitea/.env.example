#
# ISSUE 141
#
# Copy to .env and fill in values before running: cp .env.example .env
# .env is gitignored — never commit real secrets.
#

# ── Gitea ──────────────────────────────────────────────────────────────────
GITEA_DOMAIN=localhost
GITEA_BASE_URL=http://localhost:3000

# Generate with: openssl rand -hex 32
GITEA_SECRET_KEY=please-change-me-in-production
# Generate with: gitea generate secret INTERNAL_TOKEN
GITEA_INTERNAL_TOKEN=please-change-me-in-production

# ── Initial admin (created by the provisioner on first boot) ──────────────
GITEA_ADMIN_USER=admin
GITEA_ADMIN_PASS=Admin1234!

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=gitea
POSTGRES_PASSWORD=CHANGEME_replace_before_deploying
POSTGRES_DB=gitea

# ── Host ports ──────────────────────────────────────────────────────────────
HTTP_PORT=3000
SSH_PORT=2222

# ── TLS / HTTPS ──────────────────────────────────────────────────────────────
# GITEA_TLS_MODE: disabled (default HTTP) | self-signed | provided
GITEA_TLS_MODE=disabled
# Set to https when GITEA_TLS_MODE is self-signed or provided
GITEA_PROTOCOL=http

# ── Teams ────────────────────────────────────────────────────────────────────
GITEA_TEAMS=team-blue,team-red
GITEA_INSTRUCTOR_COUNT=1
GITEA_USERS_PER_TEAM=2
GITEA_USER_DOMAIN=range42.local

# ── Organisation seeding ──────────────────────────────────────────────────────
GITEA_ORG_NAME=range42-training
# Optional: pre-configure a webhook on sample repos (leave empty to skip)
GITEA_WEBHOOK_URL=
# Optional: mirror a remote git repo as read-only under the org (leave empty to skip)
# Example: GITEA_MIRROR_URL=https://github.com/torvalds/linux.git
GITEA_MIRROR_URL=
GITEA_MIRROR_REPO_NAME=public-mirror

# ── SSH key seeding ───────────────────────────────────────────────────────────
# Place scenario .pub files under ./ssh_keys/ before running `make up`.
# Expected naming (r42playbooks convention):
#   r42.<scenario>-student-key_<username>_<n>.pub
# The provisioner uploads each matching key to the corresponding Gitea user
# via POST /api/v1/admin/users/{username}/keys.  Mount is optional — omit the
# directory entirely to skip SSH key seeding.
