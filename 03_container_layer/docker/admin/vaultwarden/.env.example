#
# range42-catalog - admin/vaultwarden - environment template
#
# Copy to .env and fill in values before running:  cp .env.example .env
# .env is gitignored (see ./.gitignore) - never commit real secrets.
#

# -- Public URL --------------------------------------------------------------
# The URL Vaultwarden believes it is served on. Include the host port unless
# fronted by a reverse proxy on 80/443. The catalog-try smoke check hits
# http://<vm_ip>:<VW_HTTP_PORT>/alive - set this to that address when
# deploying to a VM (e.g. http://192.168.142.250:8080).
VW_DOMAIN=http://localhost:8080

# -- Admin panel token (REQUIRED) --------------------------------------------
# Protects the /admin panel. Generate an argon2 hash (recommended) with:
#     make hash
#     # or: docker run --rm vaultwarden/server:1.36.0-alpine /vaultwarden hash
# Paste the full "$argon2id$..." string below. QUOTE it - it contains '$'
# which compose would otherwise treat as variable interpolation.
VW_ADMIN_TOKEN='CHANGEME_replace_with_argon2_hash_from_make_hash'

# -- Account creation --------------------------------------------------------
# Lab-safe: keep signups OFF. To bootstrap the first (service) account, set
# VW_SIGNUPS_ALLOWED=true, register once via the web vault, then set it back
# to false and `make restart`. See README "Bootstrap".
VW_SIGNUPS_ALLOWED=false
VW_INVITATIONS_ALLOWED=true
VW_ORG_CREATION_USERS=all

# -- Host port ---------------------------------------------------------------
VW_HTTP_PORT=8080
