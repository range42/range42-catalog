#
# ISSUE 146
#
# Copy to .env and fill in values before running: cp .env.example .env
# .env is gitignored — never commit real secrets.
#

# ── Nextcloud ──────────────────────────────────────────────────────────────
# NC_DOMAIN : space-separated list of trusted hosts (Host header check).
# Defaults include the catalog-try VM IP so the catalog-try smoke check
# (which hits http://<vm_ip>:<port>/status.php) passes the trusted_domains
# guard. Add your own hostname / IP if deploying elsewhere.
NC_DOMAIN=localhost 192.168.142.250

# ── Initial admin (auto-created by Nextcloud on first boot) ───────────────
NC_ADMIN_USER=nc-admin
NC_ADMIN_PASS=Admin1234!

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=CHANGEME_replace_before_deploying
POSTGRES_DB=nextcloud

# ── TLS / HTTPS ──────────────────────────────────────────────────────────────
# NC_TLS_MODE: disabled | self-signed | provided
# Set to self-signed to generate a certificate for nginx. The cert is signed
# for NC_HOST_IP (the IP users reach Nextcloud on) and written to the
# nextcloud-certs Docker volume mounted by nginx.
NC_TLS_MODE=self-signed
NC_HOST_IP=192.168.142.187

# Canonical external HTTPS URL — drives OVERWRITECLIURL in the container.
# Must be https:// for OIDC to work. Port must match HTTP_PORT below.
NC_BASE_URL=https://192.168.142.187:8443

# ── Collabora Online ─────────────────────────────────────────────────────────
# Collabora is proxied at path prefixes (/browser/, /cool/, /hosting/) on the
# same nginx port as Nextcloud — no separate port or TLS exception required.
NC_COLLABORA_URL=https://192.168.142.187:8443

# ── Host ports ──────────────────────────────────────────────────────────────
# nginx listens on 443 inside the container and maps to HTTP_PORT on the host.
# Even though the variable is named HTTP_PORT, traffic on this port is HTTPS.
HTTP_PORT=8443
