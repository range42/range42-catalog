# ── MISP build / version ──────────────────────────────────────────────────────
MISP_VERSION=v2.5.37

# ── Network ───────────────────────────────────────────────────────────────────
MISP_HTTP_PORT=80
MISP_HTTPS_PORT=443
MISP_HOSTNAME=localhost

# Base URL that MISP advertises in events, feeds, and e-mails.
MISP_BASEURL=https://localhost

# ── TLS certificate ────────────────────────────────────────────────────────────
MISP_TLS_CERT=
MISP_TLS_KEY=

# ── Organisation ──────────────────────────────────────────────────────────────
MISP_ORG=Default Organisation

# ── Teams ─────────────────────────────────────────────────────────────────────
# Comma-separated list of player team names. One MISP org is created per entry.
MISP_TEAMS=team-blue,team-red
# Name of the instructor / range-admin organisation.
MISP_INSTRUCTOR_ORG=instructors
# Number of instructor accounts to create in the instructor org.
MISP_INSTRUCTOR_COUNT=1
# Number of regular (non-lead) player accounts per team.
MISP_USERS_PER_TEAM=2
# Email domain used for all generated team and instructor accounts.
MISP_USER_DOMAIN=range42.local

# ── MISP star ─────────────────────────────────────────────────────────────────
# hub   — this instance hosts the instructor org plus one local org per team in
#         MISP_TEAMS (same behaviour as misp-standalone).
# spoke — org 1 IS the team org: set MISP_ORG to the team name. No instructor
#         org and no extra team orgs are created; team users land in org 1.
#         MISP_TEAMS is ignored. Team names must not contain spaces.
MISP_STAR_MODE=hub

# Fixed UUID for the host organisation (org 1). Leave blank to derive it from
# MISP_ORG_UUID_NAMESPACE, or to keep a random UUID if that is blank too.
MISP_HOST_ORG_UUID=

# UUIDv5 namespace (itself a UUID) shared by every instance of one star.
# Each provisioned org gets uuid5(namespace, org name), so the same org name
# yields the same UUID on every instance. Sync matches orgs by UUID: without a
# shared UUID the receiving MISP duplicates the org as '<name>_<random>'.
# Generate one: python3 -c 'import uuid; print(uuid.uuid4())'
MISP_ORG_UUID_NAMESPACE=

# Default event distribution (0-4): 0 your org only, 1 this community,
# 2 connected communities, 3 all communities, 4 sharing group.
# MISP never pushes distribution 0 — a star deployment must raise this.
# Attributes, objects and event reports inherit the event distribution.
MISP_DEFAULT_DISTRIBUTION=0

# true (default): team users are Publisher (role 4) and can publish events.
# false: team users are User (role 3), which cannot publish.
# The team lead keeps Org Admin (role 2) either way.
MISP_TEAM_USERS_CAN_PUBLISH=true

# ── Security salt ─────────────────────────────────────────────────────────────
# Must be a long random string. Rotate and rebuild if compromised.
# Generate one: openssl rand -hex 32
MISP_SALT=changeme_replace_with_openssl_rand_hex_32

# ── MariaDB ───────────────────────────────────────────────────────────────────
DB_HOST=db
DB_PORT=3306
MISP_DB_NAME=misp
MISP_DB_USER=misp
MISP_DB_PASSWORD=changeme_db_password
DB_ROOT_PASSWORD=changeme_db_root_password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Admin user (primary) ──────────────────────────────────────────────────────
# cake userInit creates admin@admin.test on first boot; the entrypoint then
# changes the e-mail and password to the values below.
# Passwords must be ≥ 12 characters (MISP default policy).
MISP_ADMIN_EMAIL=admin@misp.local
MISP_ADMIN_PASSWORD=Admin1234!XYZ

# ── Admin user (secondary, optional) ─────────────────────────────────────────
# Leave both blank to skip creation of a second admin account.
MISP_ADMIN2_EMAIL=
MISP_ADMIN2_PASSWORD=

# ── Reader user (MISP role: Read Only, role_id=5) ────────────────────────────
MISP_READER_EMAIL=reader@misp.local
MISP_READER_PASSWORD=Reader1234!XYZ

# ── Writer user (MISP role: Publisher, role_id=4) ────────────────────────────
MISP_WRITER_EMAIL=writer@misp.local
MISP_WRITER_PASSWORD=Writer1234!XYZ
