#
# ISSUE 143
#
# Copy to .env and fill in values before running: cp .env.example .env
# .env is gitignored — never commit real secrets.
#

# ── Mattermost ─────────────────────────────────────────────────────────────
MM_BASE_URL=http://localhost:8065

# ── Initial admin (must match admins[0] in provisioning/users.yml) ─────────
MM_ADMIN_USER=mm-admin
MM_ADMIN_PASS=Admin1234!

# ── Default team ────────────────────────────────────────────────────────────
MM_TEAM_NAME=range42

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=mattermost
POSTGRES_PASSWORD=mattermost
POSTGRES_DB=mattermost

# ── Host ports ──────────────────────────────────────────────────────────────
HTTP_PORT=8065

# ── Gitea OAuth2 SSO (via Mattermost's "GitLab" integration) ─────────────────
# The provisioner self-registers with Gitea using GITEA_ADMIN_USER/PASS,
# then enables SSO via the Mattermost config API — no manual step required.
# GITEA_BASE_URL also pre-wires the correct Gitea endpoint URLs (not GitLab's
# /api/v4/user — Gitea uses /api/v1/user).
GITEA_BASE_URL=http://192.168.142.187:3000
GITEA_ADMIN_USER=gitea-admin
GITEA_ADMIN_PASS=

# ── Teams ────────────────────────────────────────────────────────────────────
MM_TEAMS=team-blue,team-red
MM_INSTRUCTOR_ORG=instructors
MM_INSTRUCTOR_COUNT=1
MM_USERS_PER_TEAM=2
MM_USER_DOMAIN=range42.local
