# ── Images ────────────────────────────────────────────────────────────────────
# misp-core and misp-nginx share a tag; see https://github.com/MISP/misp-docker
MISP_CORE_TAG=v2.5.50
MISP_MODULES_TAG=v3.0.12

# ── Network ───────────────────────────────────────────────────────────────────
MISP_HTTP_PORT=80
MISP_HTTPS_PORT=443

# Base URL that MISP advertises and redirects to. Must be https:// and match the
# address users browse to; the self-signed cert is issued for its host.
MISP_BASEURL=https://localhost

# ── TLS certificate ────────────────────────────────────────────────────────────
# Drop cert.pem + key.pem into ./ssl/ to serve a signed cert instead of the
# generated self-signed one.

# ── Organisation ──────────────────────────────────────────────────────────────
MISP_ORG=Default Organisation

# ── Teams ─────────────────────────────────────────────────────────────────────
# Comma-separated list of player team names. One MISP org is created per entry.
MISP_TEAMS=team-blue,team-red
# Name of the instructor / range-admin organisation.
# Defaults to MISP_ORG if left blank — the MISP host org (id=1) is renamed to
# this value at provisioning time so no separate org is created.
MISP_INSTRUCTOR_ORG=
# Number of instructor accounts to create in the instructor org.
MISP_INSTRUCTOR_COUNT=1
# Number of regular (non-lead) player accounts per team.
MISP_USERS_PER_TEAM=2
# Display name of the cross-team sharing group created at provisioning time.
# All player team orgs and the instructor org are added as members automatically.
MISP_SHARING_GROUP_NAME=all-teams
# Email domain used for all generated team and instructor accounts.
MISP_USER_DOMAIN=range42.local

# ── Security salt ─────────────────────────────────────────────────────────────
# Leave blank to let MISP generate one. Generate one: openssl rand -hex 32
MISP_SALT=

# ── MariaDB ───────────────────────────────────────────────────────────────────
MISP_DB_NAME=misp
MISP_DB_USER=misp
MISP_DB_PASSWORD=changeme_db_password
DB_ROOT_PASSWORD=changeme_db_root_password

# ── Admin user (primary) ──────────────────────────────────────────────────────
# misp-core sets user #1 to this e-mail and password on every boot.
# Passwords must be ≥ 12 characters (MISP default policy).
MISP_ADMIN_EMAIL=admin@misp.local
MISP_ADMIN_PASSWORD=Admin1234!XYZ
# Site-admin API key used by the provisioner: exactly 40 alphanumeric characters.
# Generate one: openssl rand -hex 20
MISP_ADMIN_KEY=changemechangemechangemechangemechangeme

# ── Admin user (secondary, optional) ─────────────────────────────────────────
# Leave both blank to skip creation of a second admin account.
MISP_ADMIN2_EMAIL=
MISP_ADMIN2_PASSWORD=

# ── Reader user (MISP role: Read Only, role_id=6) ────────────────────────────
MISP_READER_EMAIL=reader@misp.local
MISP_READER_PASSWORD=Reader1234!XYZ

# ── Writer user (MISP role: Publisher, role_id=4) ────────────────────────────
MISP_WRITER_EMAIL=writer@misp.local
MISP_WRITER_PASSWORD=Writer1234!XYZ
