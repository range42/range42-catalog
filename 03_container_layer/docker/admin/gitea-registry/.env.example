#
# ISSUE 142
#
# Copy to .env and fill in values before running: cp .env.example .env
# .env is gitignored — never commit real secrets.
#

# ── Gitea ──────────────────────────────────────────────────────────────────
# Registry domain (used for docker login)
GITEA_DOMAIN=localhost
# Set to https://localhost:3001 when GITEA_TLS_MODE=self-signed or provided
GITEA_BASE_URL=https://localhost:3001

# ── TLS ──────────────────────────────────────────────────────────────────────
# disabled | self-signed | provided
# self-signed: cert-gen init container generates /certs/server.{crt,key}
# provided:    mount your cert to /certs/server.{crt,key} via a named volume
GITEA_TLS_MODE=self-signed
GITEA_PROTOCOL=https

# Generate with: openssl rand -hex 32
GITEA_SECRET_KEY=CHANGEME_generate_with_openssl_rand_hex_32
# Generate with: gitea generate secret INTERNAL_TOKEN
GITEA_INTERNAL_TOKEN=CHANGEME_generate_with_gitea_generate_secret

# ── Initial admin (must match admins[0] in provisioning/users.yml) ─────────
GITEA_ADMIN_USER=gitea-admin
GITEA_ADMIN_PASS=Admin1234!

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=gitea
POSTGRES_PASSWORD=CHANGEME_replace_before_deploying
POSTGRES_DB=gitea

# ── Host ports ──────────────────────────────────────────────────────────────
HTTP_PORT=3001
SSH_PORT=3223
