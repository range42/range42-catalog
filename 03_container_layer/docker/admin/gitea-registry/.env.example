#
# ISSUE 142
#
# Copy to .env and fill in values before running: cp .env.example .env
# .env is gitignored — never commit real secrets.
#

# ── Gitea ──────────────────────────────────────────────────────────────────
# Registry domain (used for docker login)
GITEA_DOMAIN=localhost
# Set to https://localhost:3001 when GITEA_TLS_MODE=self-signed or provided
GITEA_BASE_URL=https://localhost:3001

# ── TLS ──────────────────────────────────────────────────────────────────────
# disabled | self-signed | provided
# self-signed: cert-gen init container generates /certs/server.{crt,key}
# provided:    mount your cert to /certs/server.{crt,key} via a named volume
GITEA_TLS_MODE=self-signed
GITEA_PROTOCOL=https

# Generate with: openssl rand -hex 32
GITEA_SECRET_KEY=CHANGEME_generate_with_openssl_rand_hex_32
# Generate with: gitea generate secret INTERNAL_TOKEN
GITEA_INTERNAL_TOKEN=CHANGEME_generate_with_gitea_generate_secret

# ── Initial admin (must match admins[0] in provisioning/users.yml) ─────────
GITEA_ADMIN_USER=gitea-admin
GITEA_ADMIN_PASS=Admin1234!

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=gitea
POSTGRES_PASSWORD=CHANGEME_replace_before_deploying
POSTGRES_DB=gitea

# ── Host ports ──────────────────────────────────────────────────────────────
HTTP_PORT=3001
SSH_PORT=3223

# ── Webhook on package push (issue #172) ─────────────────────────────────────
# Chat incoming-webhook URL notified on every package event (Slack payload —
# Rocket.Chat accepts it when the integration has
# overrideDestinationChannelEnabled: true). Leave empty to skip; the
# admin_services_lab scenario wires it automatically in stage_02.
GITEA_WEBHOOK_URL=
GITEA_WEBHOOK_CHANNEL=#general

# ── Package quotas (issue #172) ──────────────────────────────────────────────
# Humanized sizes accepted ("500 MB", "5 GiB"); -1 = unlimited.
GITEA_PKG_LIMIT_SIZE_CONTAINER=-1
GITEA_PKG_LIMIT_TOTAL_OWNER_SIZE=-1

# ── Garbage collection + retention (issue #172) ──────────────────────────────
# cleanup_packages cron: deletes unreferenced/expired package blob data.
GITEA_PKG_GC_SCHEDULE=@weekly
GITEA_PKG_GC_OLDER_THAN=24h
# Per-owner container cleanup rule applied by the provisioner.
# KEEP_COUNT must be one of: 1 5 10 25 50 100 — REMOVE_DAYS one of: 7 14 30 60 90 180
GITEA_PKG_KEEP_COUNT=10
GITEA_PKG_REMOVE_DAYS=30

# ── Audit / log retention (issue #172) ───────────────────────────────────────
# Access log (every registry push/pull request) goes to container stdout;
# retention = docker json-file rotation below.
GITEA_LOG_MAX_SIZE=20m
GITEA_LOG_MAX_FILES=7
# Admin-panel system notices purge (Go duration; 2160h = 90 days)
GITEA_NOTICE_RETENTION=2160h

# ── Optional docker.io pull-through cache (issue #172) ───────────────────────
# Gitea CE cannot proxy container images (go-gitea/gitea#26756); an optional
# registry:2 mirror provides hybrid online/offline fallback:
#   docker compose --profile proxy-cache up -d
PROXY_CACHE_PORT=5001
PROXY_CACHE_REMOTE=https://registry-1.docker.io
