#
# ISSUE 147
#
# Copy to .env and fill in values before running: cp .env.example .env
# .env is gitignored — never commit real secrets.
#

# ── TLS (nginx reverse proxy) ────────────────────────────────────────────────
# RC_TLS_MODE: self-signed | provided | disabled
#   self-signed → cert-gen creates a 4096-bit RSA cert valid for 10 years
#   provided    → mount your cert to /certs/server.{crt,key} before starting
#   disabled    → no cert generated; nginx will fail to start (dev use only)
RC_TLS_MODE=self-signed
RC_HOST_IP=192.168.142.187

# ── Rocket.Chat ─────────────────────────────────────────────────────────────
# RC_BASE_URL must match the external URL users access (host:HTTP_PORT, HTTPS).
# Used as ROOT_URL inside the container — must be correct for OAuth callbacks.
RC_BASE_URL=https://192.168.142.187:3500

# ── Initial admin (auto-created by Rocket.Chat on first boot) ───────────────
RC_ADMIN_USER=rc-admin
RC_ADMIN_PASS=Admin1234!
RC_ADMIN_EMAIL=admin@range42.local

# ── Host ports ──────────────────────────────────────────────────────────────
# nginx listens on 443 inside the container and maps to HTTP_PORT on the host.
HTTP_PORT=3500

# ── Gitea OAuth2 SSO ────────────────────────────────────────────────────────
# The provisioner self-registers with Gitea using GITEA_ADMIN_USER/PASS,
# then configures the Custom OAuth2 provider on first boot — no manual step needed.
# Optionally pre-supply RC_GITEA_CLIENT_ID/SECRET to skip self-registration.
GITEA_BASE_URL=http://192.168.142.187:3000
GITEA_ADMIN_USER=gitea-admin
GITEA_ADMIN_PASS=
RC_GITEA_CLIENT_ID=
RC_GITEA_CLIENT_SECRET=
